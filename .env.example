# BlockWill uses per-workspace environment files:
#   backend/.env   — see backend/.env.example  (DATABASE_URL, JWT_SECRET, ENCRYPTION_KEY, blockchain RPC + contract addresses)
#   frontend/.env  — see frontend/.env.example (VITE_API_URL, VITE_CHAIN_ID, VITE_CHAIN_NAME, VITE_RPC_URL)
#
# This root file exists only as a quick-reference summary. Copy the two files
# above and fill them in — do not create secrets here or commit real values
# anywhere in this repo.

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://blockwill:blockwill@localhost:5432/blockwill?schema=public

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Blockchain (local Hardhat network) ──────────────────────────────────────
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
WILL_REGISTRY_ADDRESS=
INHERITANCE_MANAGER_ADDRESS=
EXECUTOR_MANAGER_ADDRESS=
BWILL_TOKEN_ADDRESS=

# ── Document encryption ─────────────────────────────────────────────────────
ENCRYPTION_KEY=
